# Required
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_PROFILE_ENCRYPTION_KEY=
APP_URL=
APP_ORIGINS=http://localhost:3000,https://socialsignaldesk.com,https://signaldesk-social.vercel.app
# Emails of the people who manage beta invites (comma-separated)
PLATFORM_ADMIN_EMAILS=
CRON_SECRET=

# Public legal pages (/privacy, /terms, /data-deletion). The contact email is shown on all three.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=

# Direct publishing: Facebook + Instagram (Meta), LinkedIn, Pinterest
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Company Pages: a second LinkedIn app with only the Community Management API (LinkedIn requires it to be alone on its app)
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_SANDBOX=
# X (Twitter) — OAuth 2.0 app with read and write access
X_CLIENT_ID=
X_CLIENT_SECRET=
# YouTube — Google Cloud OAuth client (Web application) with the YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok — Content Posting API (Login Kit + Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Threads — the Threads use case on a Meta app (its own Threads app ID and secret)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional: newer API versions without a code change (defaults: v23.0 and 202607)
# META_GRAPH_VERSION=
# LINKEDIN_API_VERSION=

# Optional: Ayrshare for networks SignalDesk doesn't connect directly (Bluesky, Reddit, and others)
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
# Only for X through Ayrshare
X_TWITTER_OAUTH1_API_KEY=
X_TWITTER_OAUTH1_API_SECRET=

# Optional: AI features, notification and report emails, push notifications
ANTHROPIC_API_KEY=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Stock photos in the Publishing Studio (free key from unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
