{
  "functions": {
    "api/social.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/oauth.js": {
      "maxDuration": 60
    },
    "api/legal.js": {
      "maxDuration": 30
    },
    "api/go.js": {
      "maxDuration": 10
    },
    "api/invite-request.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron?only=health",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/b/:slug",
      "destination": "/bio.html"
    },
    {
      "source": "/privacy",
      "destination": "/api/legal?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/legal?page=terms"
    },
    {
      "source": "/data-deletion",
      "destination": "/api/legal?page=data-deletion"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/icon-192.png"
    },
    {
      "source": "/l/:code",
      "destination": "/api/go?code=:code"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.socialsignaldesk.com"
        }
      ],
      "destination": "https://socialsignaldesk.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "signaldesk-social.vercel.app"
        }
      ],
      "destination": "https://socialsignaldesk.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-mu6HenCP3Dpo5oYB3GAArU/+80rZooyqC0Cal/nuQwU=' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/js/app.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/app.min.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
