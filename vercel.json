{
  "functions": {
    "api/social.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/oauth.js": {
      "maxDuration": 60
    },
    "api/legal.js": {
      "maxDuration": 30
    },
    "api/go.js": {
      "maxDuration": 10
    },
    "api/invite-request.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron?only=health",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/b/:slug",
      "destination": "/bio.html"
    },
    {
      "source": "/privacy",
      "destination": "/api/legal?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/legal?page=terms"
    },
    {
      "source": "/data-deletion",
      "destination": "/api/legal?page=data-deletion"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/icon-192.png"
    },
    {
      "source": "/l/:code",
      "destination": "/api/go?code=:code"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.socialsignaldesk.com"
        }
      ],
      "destination": "https://socialsignaldesk.com/:path*",
      "permanent": true
    }
  ]
}
